{
	# Public TCP/443 is owned by Xray Reality. Ordinary HTTPS handshakes are
	# forwarded to this internal Caddy listener, while public HTTP/80 remains
	# available for redirects and ACME challenges.
	https_port 8444
}

vpn.akalmaz.tech, tcp.vpn.akalmaz.tech {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@geo path /routing/geoip.dat /routing/geoip.dat.sha256 /routing/geosite.dat /routing/geosite.dat.sha256
	handle @geo {
		root * /var/lib/my-vpn-routing
		file_server
		header Cache-Control "public, max-age=86400, immutable"
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}

	# Access logging is intentionally disabled: subscription credentials are
	# carried in /s/{token} and must never be written to disk or journald.
}
