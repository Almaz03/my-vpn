[Unit]
Description=Back up family VPN portal state
ConditionPathExists=/var/lib/my-vpn/my-vpn.db

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/my-vpn/backup.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/my-vpn /var/lib/my-vpn /run/lock
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
