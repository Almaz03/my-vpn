[Unit]
Description=Family VPN portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=my-vpn
Group=my-vpn
EnvironmentFile=/etc/my-vpn/my-vpn.env
EnvironmentFile=/etc/my-vpn/xray-client.env
ExecStart=/opt/my-vpn/current/my-vpn
WorkingDirectory=/opt/my-vpn/current
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=15s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/my-vpn

[Install]
WantedBy=multi-user.target
