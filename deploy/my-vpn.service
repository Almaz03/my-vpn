[Unit]
Description=Family VPN portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=my-vpn
Group=my-vpn
EnvironmentFile=/etc/my-vpn/my-vpn.env
ExecStart=/opt/my-vpn/current/my-vpn
WorkingDirectory=/opt/my-vpn/current
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=15s

# The unprivileged service may elevate only through the root-owned
# narrowly scoped provisioning helpers allowed by /etc/sudoers.d/my-vpn.
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Available only after the sudoers-controlled transition to the root helper;
# the my-vpn process itself receives no effective or ambient capabilities.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID CAP_AUDIT_WRITE
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/my-vpn

[Install]
WantedBy=multi-user.target
